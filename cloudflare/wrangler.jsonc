{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poemofdestinycreativeworkshop",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-12",
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  },
  "durable_objects": {
    "bindings": [{ "name": "CODE_CHECK_SERVICE", "class_name": "CodeCheckService" }]
  },
  "migrations": [{ "tag": "code-check-service-v1", "new_sqlite_classes": ["CodeCheckService"] }],
  "triggers": {
    "crons": ["0 2,8,14,20 * * *", "5 0 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "creative_workshop",
      "database_id": "d15eff29-c6a2-4bc8-9e5d-c7e3752bbc39"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "ff7b3bce7ce04cf08f0c77dbd0367031"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "creative-workshop-projects"
    }
  ]
}
