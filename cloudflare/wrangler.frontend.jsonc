{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "poemofdestinycreativeworkshop-frontend",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-12",
	"workers_dev": true,
	"dev": {
		"port": 8791
	},
	"vars": {
		"ALLOWED_GUILD_IDS": "",
		"ADMIN_ROLE_IDS": "",
		"SUPER_ADMIN_USER_ID": ""
	},
	"d1_databases": [
		{
			"binding": "DB"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION_KV"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_BUCKET"
		}
	]
}
