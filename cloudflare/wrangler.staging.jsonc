{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poemofdestinycreativeworkshop-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-12",
  "dev": {
    "port": 8790
  },
  "triggers": {
    "crons": ["5 * * * *"]
  },
  "vars": {
    "ALLOWED_GUILD_IDS": "",
    "ADMIN_ROLE_IDS": "",
    "SUPER_ADMIN_USER_ID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "creative_workshop_staging",
      "database_id": "c3e74b23-d969-4f76-87a1-df2bf5fd63c2"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "94b70bfd1b144386a28c418fb7345727"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "poemofdestinycreativeworkshop-staging-r2-bucket"
    }
  ]
}
