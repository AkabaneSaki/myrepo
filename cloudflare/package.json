{
  "name": "cloudflare-workers-openapi",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "check:version-policy": "node tests/version-policy-smoke.mjs",
    "check:version-label-migration": "node tests/project-version-label-migration-smoke.mjs",
    "check:inspection-summary-migration": "node tests/project-inspection-summary-migration-smoke.mjs",
    "check:taxonomy-migration": "node tests/project-taxonomy-migration-smoke.mjs",
    "check:home-js-smoke": "node tests/home-js-smoke.mjs",
    "check:types": "tsc -p tsconfig.json",
    "dev": "wrangler dev",
    "dev:local-test": "wrangler dev --local --config wrangler.local-test.jsonc",
    "dev:local-snapshot": "wrangler dev --local --config wrangler.jsonc --persist-to .wrangler/local-production-20260906 --ip 127.0.0.1 --port 8792 --var JWT_SECRET:cw-local-snapshot",
    "dev:lan": "wrangler dev --config wrangler.local-test.jsonc --local --ip 0.0.0.0 --port 8790",
    "dev:test-api": "node scripts/start-local-api-test.mjs",
    "check:home-js": "node scripts/check-home-js.mjs",
    "check:worldbook-normalize": "node scripts/check-worldbook-normalize.mjs",
    "check:workshop-worldbook-reconcile": "node scripts/check-workshop-worldbook-reconcile.mjs",
    "check:workshop-entry-name": "node tests/workshop-entry-name-v2.mjs",
    "check:project-content": "node scripts/check-project-content.mjs",
    "build:inspection-backfill": "node scripts/build-project-inspection-backfill.mjs",
    "check:review-diff": "node tests/project-review-diff.mjs",
    "check:project-ranking": "node tests/project-ranking.mjs",
    "check:project-daily-ranking": "node tests/project-daily-ranking-smoke.mjs",
    "check:project-ranking-snapshot": "node tests/project-ranking-snapshot-smoke.mjs",
    "check:character-reference": "node tests/character-reference-fingerprint.mjs",
    "check:character-reference-registry": "node tests/character-reference-registry-smoke.mjs",
    "check:creative-workshop-syntax": "node scripts/check-creative-workshop-syntax.mjs",
    "check:creative-workshop-regex-identity": "node tests/creative-workshop-regex-identity-smoke.mjs",
    "check:local-api-workflow": "node scripts/check-local-api-workflow.mjs",
    "check:cover-isolation": "node tests/cover-approval-isolation.mjs",
    "check:content-validation": "node tests/content-validation-approval.mjs",
    "check:admin-review-recovery": "node tests/admin-review-recovery-smoke.mjs",
    "check:review-snapshot-flow": "node tests/review-snapshot-flow-smoke.mjs",
    "test:db-init-local": "wrangler d1 execute creative_workshop_local_test --local --config wrangler.local-test.jsonc --file=schema.sql",
    "test:db-snapshot-seed-local": "wrangler d1 execute creative_workshop --local --config wrangler.jsonc --persist-to .wrangler/local-production-20260906 --file=../../workshop-backups/2026-09-06/creative_workshop.sql",
    "test:db-snapshot-migrate-local": "wrangler d1 migrations apply creative_workshop --local --config wrangler.jsonc --persist-to .wrangler/local-production-20260906",
    "check:db-snapshot-local": "wrangler d1 execute creative_workshop --local --config wrangler.jsonc --persist-to .wrangler/local-production-20260906 --command=\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name;\"",
    "check:db-snapshot-stats-local": "wrangler d1 execute creative_workshop --local --config wrangler.jsonc --persist-to .wrangler/local-production-20260906 --command=\"SELECT (SELECT COUNT(*) FROM projects) AS projects, (SELECT COUNT(*) FROM users) AS users, (SELECT COUNT(*) FROM project_likes) AS likes, (SELECT COUNT(*) FROM project_subscribes) AS subscriptions;\"",
    "check:db-snapshot-migrations-local": "wrangler d1 migrations list creative_workshop --local --config wrangler.jsonc --persist-to .wrangler/local-production-20260906",
    "check:local-snapshot-http": "node scripts/check-local-snapshot-http.mjs",
    "check:d1-cost": "node tests/project-daily-ranking-smoke.mjs && node scripts/check-d1-cost.mjs",
    "check:db-migrations-local": "wrangler d1 migrations list creative_workshop_local_test --local --config wrangler.local-test.jsonc",
    "test:db-migrate-local": "wrangler d1 migrations apply creative_workshop_local_test --local --config wrangler.local-test.jsonc",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "cf-typegen:local-test": "wrangler types --config wrangler.local-test.jsonc",
    "check:project-precautions": "node tests/project-precautions-smoke.mjs",
    "check:creative-workshop-conflict-consent": "node tests/creative-workshop-conflict-consent-smoke.mjs",
    "check:creative-workshop-stale-id-rebind": "node tests/creative-workshop-stale-id-rebind-smoke.mjs",
    "check:creative-workshop-name-format": "node tests/workshop-entry-name-v2.mjs && node scripts/check-workshop-worldbook-reconcile.mjs && node tests/creative-workshop-repair-smoke.mjs && node tests/creative-workshop-stale-id-rebind-smoke.mjs",
    "check:creative-workshop-repair-d1-guard": "node tests/creative-workshop-repair-d1-guard-smoke.mjs",
    "check:creative-workshop-original-conflicts": "node tests/creative-workshop-original-conflicts-smoke.mjs",
    "check:workshop-config": "node ../scripts/check-workshop-config.mjs"
  },
  "dependencies": {
    "chanfana": "^2.6.3",
    "hono": "^4.6.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/service-worker-mock": "^2.0.4",
    "wrangler": "^4.131.1"
  }
}
