{
	"name": "cloudflare-workers-openapi",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy --config wrangler.jsonc",
		"deploy:staging": "wrangler deploy --config wrangler.staging.jsonc",
		"deploy:master-staging": "wrangler deploy --config wrangler.master-staging.jsonc",
		"check:production": "wrangler deploy --dry-run --config wrangler.jsonc",
		"check:staging": "wrangler deploy --dry-run --config wrangler.staging.jsonc",
		"check:version-policy": "node tests/version-policy-smoke.mjs",
		"check:version-label-migration": "node tests/project-version-label-migration-smoke.mjs",
		"check:home-js-smoke": "node tests/home-js-smoke.mjs",
		"check:oauth-external-browser": "node tests/oauth-external-browser-smoke.mjs",
		"check:types": "tsc -p tsconfig.json",
		"dev": "wrangler dev",
		"dev:staging": "wrangler dev --config wrangler.staging.jsonc",
		"dev:lan": "wrangler dev --config wrangler.staging.jsonc --local --ip 0.0.0.0 --port 8790",
		"dev:test-api": "node scripts/start-local-api-test.mjs",
		"check:home-js": "node scripts/check-home-js.mjs",
		"check:worldbook-normalize": "node scripts/check-worldbook-normalize.mjs",
		"check:project-content": "node scripts/check-project-content.mjs",
		"check:creative-workshop-syntax": "node scripts/check-creative-workshop-syntax.mjs",
		"check:local-api-workflow": "node scripts/check-local-api-workflow.mjs",
		"check:cover-isolation": "node tests/cover-approval-isolation.mjs",
		"check:content-validation": "node tests/content-validation-approval.mjs",
		"test:db-init-local": "wrangler d1 execute creative_workshop_staging --local --config wrangler.staging.jsonc --file=schema.sql",
		"check:db-migrations-local": "wrangler d1 migrations list creative_workshop_staging --local --config wrangler.staging.jsonc",
		"test:db-migrate-local": "wrangler d1 migrations apply creative_workshop_staging --local --config wrangler.staging.jsonc",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"cf-typegen:staging": "wrangler types --config wrangler.staging.jsonc"
	},
	"dependencies": {
		"chanfana": "^2.6.3",
		"hono": "^4.6.20",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/node": "^22.13.0",
		"@types/service-worker-mock": "^2.0.4",
		"wrangler": "^4.74.0"
	}
}
