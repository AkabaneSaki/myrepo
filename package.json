{
  "name": "poem-of-destiny-workshop-scripts",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "webpack --config webpack.config.cjs --mode production && node scripts/build-workshop-legacy-shim.mjs",
    "watch": "node scripts/build-workshop-legacy-shim.mjs && webpack --config webpack.config.cjs --mode development --watch",
    "check:workshop-config": "node scripts/check-workshop-config.mjs",
    "check:workshop-bundles": "node scripts/check-workshop-bundles.mjs",
    "test:quick": "playwright test --config playwright.config.mjs --grep @quick",
    "test:ejs-preflight": "playwright test tests/e2e/ejs-preflight.spec.mjs --config playwright.config.mjs --project desktop-chromium --retries=0 --reporter=line",
    "test:journey": "playwright test --config playwright.config.mjs --project desktop-chromium --project mobile-chromium",
    "test:st:setup": "node scripts/setup-st-test-profile.mjs",
    "test:st:setup:anonymous": "node scripts/setup-st-test-profile.mjs anonymous",
    "test:st:setup:player": "node scripts/setup-st-test-profile.mjs authenticated-player",
    "test:st": "playwright test tests/e2e/st-control.spec.mjs --config playwright.config.mjs --project st-edge --retries=0 --reporter=line",
    "test:issues:core": "playwright test tests/e2e/issue-regression.spec.mjs --config playwright.config.mjs --project st-edge --retries=0 --reporter=line",
    "test:issue39": "playwright test tests/e2e/issue-regression.spec.mjs --config playwright.config.mjs --project st-edge --grep 39 --retries=0 --reporter=line",
    "test:issue47": "playwright test tests/e2e/issue-regression.spec.mjs --config playwright.config.mjs --project st-edge --grep 47 --retries=0 --reporter=line",
    "test:auth": "playwright test tests/e2e/auth-regression.spec.mjs --config playwright.config.mjs --project st-edge --retries=0 --reporter=line",
    "test:auth-gate": "playwright test tests/e2e/auth-regression.spec.mjs --config playwright.config.mjs --project st-edge --grep 44 --retries=0 --reporter=line",
    "test:update-center": "playwright test tests/e2e/auth-regression.spec.mjs --config playwright.config.mjs --project st-edge --grep 45 --retries=0 --reporter=line",
    "test:keyboard": "playwright test tests/e2e/keyboard-regression.spec.mjs --config playwright.config.mjs --project st-edge --retries=0 --reporter=line",
    "test:issues": "playwright test tests/e2e/issue-regression.spec.mjs tests/e2e/auth-regression.spec.mjs --config playwright.config.mjs --project st-edge --retries=0 --reporter=line",
    "test:player": "playwright test tests/e2e/st-control.spec.mjs tests/e2e/issue-regression.spec.mjs tests/e2e/auth-regression.spec.mjs --config playwright.config.mjs --project st-edge --retries=0 --reporter=line",
    "test:css-regression": "playwright test tests/e2e/css-regression.spec.mjs tests/e2e/keyboard-regression.spec.mjs --config playwright.config.mjs --project st-edge --retries=0 --reporter=line",
    "test:visual": "playwright test tests/e2e/css-regression.spec.mjs --config playwright.config.mjs --project st-edge --grep @css-regression --retries=0 --reporter=line",
    "test:visual:update": "playwright test tests/e2e/css-regression.spec.mjs --config playwright.config.mjs --project st-edge --grep @css-regression --update-snapshots --retries=0 --reporter=line"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "ts-loader": "9.5.2",
    "typescript": "5.9.2",
    "webpack": "5.101.3",
    "webpack-cli": "6.0.1"
  }
}
